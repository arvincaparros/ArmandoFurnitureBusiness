JWT_SECRET_KEY=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Password reset tokens (app/services/auth.py)
RESET_TOKEN_EXPIRE_MINUTES=30

# Password reset email delivery (app/services/email.py). No real
# email provider is integrated yet - "console" (the default) logs the
# reset link to the backend console/log instead of sending it, which
# is safe for local development only. FRONTEND_URL is used to build
# that link (http://localhost:5173/reset-password?token=...).
EMAIL_PROVIDER=console
FRONTEND_URL=http://localhost:5173
