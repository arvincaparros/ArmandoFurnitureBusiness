# Optional customization for the client Docker deployment
# (docker-compose.client.yml). NOT required for the default demo
# flow - start-demo.bat works without this file.
#
# To use it: copy this file to ".env" in the same folder as
# docker-compose.client.yml, edit the values below, then run
# start-demo.bat (or `docker compose -f docker-compose.client.yml up
# -d --build`) again so the new values take effect.

# A random secret used to sign login sessions. The demo ships with a
# built-in default (see docker-compose.client.yml) so this is only
# worth setting if you want a unique value for this installation.
JWT_SECRET_KEY=replace-with-a-random-secret-value

# Optional. Leave blank to keep the Demand Forecasting AI Assistant
# chat disabled - every other feature works without it. Set this to
# enable that one feature.
GEMINI_API_KEY=
